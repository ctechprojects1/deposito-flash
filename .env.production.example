# =============================================================================
#  .env de PRODUÇÃO (HostGator / cPanel)
#  Copie para ".env" no servidor e preencha os valores reais.
# =============================================================================

APP_NAME="Estoque Enderecamento"
APP_ENV=production
APP_KEY=                      # gere com: php artisan key:generate
APP_DEBUG=false               # NUNCA true em produção
APP_URL=https://estoque.seudominio.com.br

# Log mais enxuto em produção
LOG_CHANNEL=stack
LOG_LEVEL=error

# -----------------------------------------------------------------------------
#  BANCO DE DADOS — MySQL do cPanel
# -----------------------------------------------------------------------------
#  No cPanel > "Bancos de Dados MySQL":
#   1) Crie o banco            -> vira:  cpaneluser_estoque
#   2) Crie o usuário          -> vira:  cpaneluser_estuser
#   3) Adicione o usuário ao banco com TODOS OS PRIVILÉGIOS
#  O prefixo "cpaneluser_" é obrigatório e é adicionado automaticamente pelo cPanel.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost            # na HostGator é "localhost" (não 127.0.0.1)
DB_PORT=3306
DB_DATABASE=cpaneluser_estoque
DB_USERNAME=cpaneluser_estuser
DB_PASSWORD=senha_forte_aqui

# -----------------------------------------------------------------------------
#  SESSÃO / CACHE — em hospedagem compartilhada use o banco ou arquivo
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
#  INTEGRAÇÃO MICROVIX
# -----------------------------------------------------------------------------
MICROVIX_API_URL=
MICROVIX_API_KEY=
MICROVIX_API_TIMEOUT=15
